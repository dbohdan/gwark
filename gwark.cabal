author:          John MacFarlane <jgm@berkeley.edu>
maintainer:      John MacFarlane <jgm@berkeley.edu>
bug-reports:     https://github.com/jgm/pandoc/issues
stability:       alpha
homepage:        https://pandoc.org
category:        Text
tested-with:     GHC == 9.6.7, GHC == 9.8.4, GHC == 9.10.3, GHC == 9.12.2
synopsis:        Conversion between Pandoc Markdown and HTML (lean fork)
description:     Lean fork of pandoc, reduced to the formats needed by
                 Hakyll-based static site builds. Supports:
                 .
                 - the Pandoc Markdown reader (full classical extension set,
                   including +latex_macros)
                 - the HTML reader
                 - the HTML5 writer (HTML4 also)
                 - the Markdown writer, plain writer, and Markua writer
                 - the JSON filter pipeline
                 .
                 Removed: every other reader and writer, citeproc, the Lua
                 scripting engine, and the pandoc-server HTTP API. The
                 LaTeX reader is retained in stripped form so that the
                 Markdown reader's @+latex_macros@ extension and
                 raw-LaTeX passthrough continue to work.
                 .
                 The CLI executable lives in the @pandoc-cli@ package.
data-files:
                 -- templates
                 data/templates/styles.html
                 data/templates/styles.citations.html
                 data/templates/default.html4
                 data/templates/default.html5
                 data/templates/default.chunkedhtml
                 data/templates/default.markdown
                 data/templates/default.markua
                 data/templates/default.commonmark
                 data/templates/default.plain
                 -- entities
                 data/docbook-entities.txt
                 -- English translations (Translations module looks up
                 -- terms like "Abstract", "Bibliography" here)
                 data/translations/en.yaml
                 -- default abbreviations file
                 data/abbreviations
                 -- bash completion template
                 data/bash_completion.tpl
                 -- documentation
                 MANUAL.txt, COPYRIGHT
