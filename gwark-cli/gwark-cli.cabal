cabal-version:   2.4
name:            gwark-cli
version:         3.9.0.2
build-type:      Simple
license:         GPL-2.0-or-later
license-file:    COPYING.md
copyright:       (c) 2006-2024 John MacFarlane
author:          John MacFarlane <jgm@berkeley.edu>
maintainer:      John MacFarlane <jgm@berkeley.edu>
bug-reports:     https://github.com/jgm/pandoc/issues
stability:       alpha
homepage:        https://pandoc.org
category:        Text
synopsis:        Conversion between Pandoc Markdown and HTML (lean fork CLI)
description:     Command-line executable for the lean pandoc fork.
                 The HTTP server and Lua REPL flags from upstream are
                 removed. Lua filter support is on by default; build
                 with -f-lua to drop it.
extra-source-files:
                 man/gwark.1
source-repository head
  type:          git
  location:      https://github.com/dbohdan/pandoc.git

flag lua
  Description:   Support custom modifications and conversions with
                 the pandoc Lua scripting engine. Filters only;
                 the @gwark lua@ REPL subcommand is not exposed.
  Default:       True

flag nightly
  Description:   Add '-nightly-COMPILEDATE' to the output of '--version'.
  Default:       False

common common-options
  default-language: Haskell2010
  other-extensions: OverloadedStrings
  build-depends:    base         >= 4.18 && < 5
  ghc-options:      -Wall -fno-warn-unused-do-bind
                    -Wincomplete-record-updates
                    -Wnoncanonical-monad-instances
                    -Wcpp-undef
                    -Wincomplete-uni-patterns
                    -Widentities
                    -Wpartial-fields
                    -Wmissing-signatures
                    -fhide-source-paths
                    -Wunused-packages
                    -Winvalid-haddock

  if os(windows)
    cpp-options:      -D_WINDOWS

common common-executable
  import:           common-options
  ghc-options:      -rtsopts -with-rtsopts=-A8m

executable gwark
  import:          common-executable
  main-is:         gwark.hs
  hs-source-dirs:  src
  buildable:       True
  -- Always link to the exact gwark library version of this package.
  build-depends:   gwark == 3.9.0.2, text
  other-modules:   PandocCLI.Lua

  ghc-options:     -threaded

  if flag(lua)
    build-depends:   pandoc-lua-engine >= 0.5 && < 0.6
    hs-source-dirs:  lua
    cpp-options:     -DLUA
  else
    hs-source-dirs:  no-lua

  if flag(nightly)
    cpp-options:    -DNIGHTLY
    build-depends:  template-haskell,
                    time
